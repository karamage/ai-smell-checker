{
	"name": "niou",
	"version": "0.1.0",
	"description": "NIOU — AI臭い文章チェッカー。日本語の文章からAIっぽい箇所を静的解析で炙り出す",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"dev:ai": "NIOU_REMOTE_AI=1 vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "vite build && wrangler deploy",
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
		"lint": "oxlint src && biome check .",
		"format": "biome check --write .",
		"cli": "bun run src/cli.ts",
		"cf-typegen": "wrangler types"
	},
	"license": "MIT",
	"dependencies": {
		"hono": "^4.13.8",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"workers-og": "^0.0.27"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@cloudflare/vite-plugin": "^1.54.11",
		"@cloudflare/workers-types": "^5.20260917.1",
		"@types/bun": "^1.4.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"oxlint": "^1.83.0",
		"typescript": "7",
		"vite": "^8.3.0",
		"wrangler": "^4.133.0"
	}
}
